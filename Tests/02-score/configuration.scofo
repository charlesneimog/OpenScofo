// Every score-configurable default is overridden here.
SR 44100
FFTSIZE 4096
HOPSIZE 256
TUNINGA4 442
TRANSPOSE 12
PITCHTEMPLATESIGMA 0.75
PITCHTEMPLATEHARMONICS 6
PHASECOUPLING 1.25
SYNCSTRENGTH 0.75
TIMETOLERANCE 0.25
SECTIONRESTRICT ON
DBTHRESHOLD -48
ONSETFUNCTION cd
MEDSPAN 31
MFCCMELS 32
MFCCCOUNT 16
SPECTRALROLLOFFCUTOFF 0.65
YINTHRESHOLD 0.25
YINMINFREQUENCY 80
YINMAXFREQUENCY 1200
CHROMASIZE 24
CHROMACENTEROCTAVE 4
CHROMAOCTAVEWIDTH 1.5
ZCRCENTER OFF
ZCRPAD ON
ZCRZEROPOS OFF
ZCRTHRESHOLD 0.002
ONAUDIOSTATECHANGE configuration_state
ONNXMODEL "configuration.onnx"
ONNXDESCRIPTORS rms centroid

SECTION "configured"
BPM 90
NOTE A4 1
REST 0.5
UTECH loud 1

SECTION "other"
NOTE C5 1
