{
    "name": "openscofo",
    "displayName": "OpenScofo",
    "description": "Syntax highlighting for OpenScofo language",
    "version": "0.0.1",
    "publisher": "your-name",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "openscofo",
                "aliases": [
                    "OpenScofo",
                    "openscofo"
                ],
                "extensions": [
                    ".scofo"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "openscofo",
                "scopeName": "source.openscofo",
                "path": "./syntaxes/openscofo.tmLanguage.json"
            }
        ]
    }
}
